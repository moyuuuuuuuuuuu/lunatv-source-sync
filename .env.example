# Single administrator credentials (required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Long random value used to hash session tokens (required)
SESSION_SECRET=replace-with-a-long-random-secret

# HTTP listener port
PORT=3000

# SQLite database file
DATABASE_PATH=/app/data/app.db

# Extra comma-separated adult-classification keywords
ADULT_KEYWORDS_EXTRA=

# Local HTTP defaults. Behind a trusted HTTPS reverse proxy, set both to true.
SECURE_COOKIES=false
TRUST_PROXY=false

# Optional HTTP CONNECT proxy for health checks, URL imports, and source proxying.
# From Docker, use host.docker.internal to reach a proxy listening on the host.
OUTBOUND_PROXY_URL=
OUTBOUND_PROXY_REMOTE_DNS=false
