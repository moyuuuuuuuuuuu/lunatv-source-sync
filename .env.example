# Single administrator credentials (required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Long random value used to hash session tokens (required)
SESSION_SECRET=replace-with-a-long-random-secret

# Leave blank to allow public subscriptions
SUBSCRIPTION_TOKEN=

# HTTP listener port
PORT=3000

# SQLite database file
DATABASE_PATH=/app/data/app.db

# Extra comma-separated adult-classification keywords
ADULT_KEYWORDS_EXTRA=
